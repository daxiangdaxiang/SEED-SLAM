{
  "schema_version": "mrclam_benchmark_manifest_v1",
  "benchmark_id": "mrclam_dataset1_native5_v3",
  "description": "UTIAS MR.CLAM Dataset 1, five physical robots with shared cylindrical barcode landmarks and no artificial initialization perturbation",
  "native_multi_robot": true,
  "source": {
